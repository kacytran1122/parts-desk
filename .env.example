# Copy to .env (never commit it). Start with:
#   uv run --env-file .env uvicorn --factory partsdesk.api.app:create_app --host 127.0.0.1 --port 8000
# Required for any shared, publicly reachable, or live-enabled instance.
PARTS_DESK_OPS_TOKEN=
PARTS_DESK_DATA_DIR=data
PARTS_DESK_LIVE=0
# The one consenting, verified test iPhone (+E.164) allowed to call and send photos.
PARTS_DESK_TEST_PHONE=
# Chert messaging (incoming iMessage attachments)
CHERT_TENANT=
CHERT_API_KEY=
CHERT_WEBHOOK_SECRET=
# Chert FaceTime (Bring Your Own Room)
CHERT_PROJECT_ID=
CHERT_PROJECT_KEY=
CHERT_FACETIME_LINE_ID=
# LiveKit Cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
